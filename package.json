{
  "name": "wordscodex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wordscodex/web --filter @wordscodex/api dev",
    "dev:web": "pnpm --filter @wordscodex/web dev",
    "dev:api": "pnpm --filter @wordscodex/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit --project tsconfig.scripts.json",
    "test": "pnpm -r test && vitest run scripts/import-vocabulary/validator.test.ts scripts/release-readiness/checklist.test.ts scripts/release-readiness/audit.test.ts",
    "test:e2e": "pnpm --filter @wordscodex/web test:e2e",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @wordscodex/api db:generate",
    "db:deploy": "pnpm --filter @wordscodex/api db:deploy",
    "db:migrate": "pnpm --filter @wordscodex/api db:migrate",
    "db:seed": "pnpm --filter @wordscodex/api db:seed",
    "vocabulary:validate": "tsx scripts/import-vocabulary/cli.ts validate",
    "vocabulary:import": "tsx scripts/import-vocabulary/cli.ts import",
    "release:audit": "tsx scripts/release-readiness/audit-cli.ts",
    "release:check": "tsx scripts/release-readiness/cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
