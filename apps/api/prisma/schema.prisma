generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  learner
  admin
}

enum AccountType {
  guest
  registered
}

enum VocabularyCategory {
  k12
  college
  postgraduate
  overseas
  workplace
}

enum LearningGoal {
  k12
  college
  postgraduate
  overseas
  workplace
}

enum StudyPlanStatus {
  active
  paused
  completed
}

enum MasteryState {
  new
  learning
  fuzzy
  mistake
  mastered
  lapsed
}

enum StudySessionMode {
  new_words
  review
  mistake_drill
  mixed
}

enum StudySessionStatus {
  active
  completed
  abandoned
}

enum QuestionType {
  word_to_meaning
  meaning_to_word
  spelling
  listening
}

enum ReviewRating {
  again
  hard
  good
  easy
}

model SystemMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String             @id @default(cuid())
  email         String?            @unique
  displayName   String             @default("学习者")
  role          UserRole           @default(learner)
  accountType   AccountType        @default(guest)
  timezone      String             @default("Asia/Shanghai")
  sessions      AuthSession[]
  studyPlans    StudyPlan[]
  wordProgress  UserWordProgress[]
  studySessions StudySession[]
  reviewLogs    ReviewLog[]
  checkins      Checkin[]
  analytics     AnalyticsEvent[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model VocabularyBook {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  category    VocabularyCategory
  description String
  wordCount   Int
  version     Int                @default(1)
  publishedAt DateTime?
  studyPlans  StudyPlan[]
  words       VocabularyWord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([category])
  @@index([publishedAt])
}

model StudyPlan {
  id                 String          @id @default(cuid())
  userId             String
  vocabularyBookId   String
  learningGoal       LearningGoal
  dailyNewWordTarget Int
  dailyReviewLimit   Int             @default(80)
  targetDate         DateTime?
  reminderEnabled    Boolean         @default(false)
  status             StudyPlanStatus @default(active)
  startedAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyBook     VocabularyBook  @relation(fields: [vocabularyBookId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([vocabularyBookId])
  @@index([status])
}

model VocabularyWord {
  id                   String             @id @default(cuid())
  vocabularyBookId     String
  lemma                String
  partOfSpeech         String
  definitionZh         String
  definitionEn         String?
  phoneticUk           String?
  phoneticUs           String?
  audioUkUrl           String?
  audioUsUrl           String?
  imageUrl             String?
  exampleSentence      String?
  exampleTranslationZh String?
  exampleSource        String?
  position             Int
  contentVersion       Int                @default(1)
  vocabularyBook       VocabularyBook     @relation(fields: [vocabularyBookId], references: [id], onDelete: Cascade)
  progress             UserWordProgress[]
  sessionItems         StudySessionItem[]
  reviewLogs           ReviewLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([vocabularyBookId, lemma])
  @@unique([vocabularyBookId, position])
  @@index([vocabularyBookId])
}

model UserWordProgress {
  userId             String
  wordId             String
  masteryState       MasteryState   @default(new)
  repetitions        Int            @default(0)
  consecutiveCorrect Int            @default(0)
  correctCount       Int            @default(0)
  incorrectCount     Int            @default(0)
  easeFactor         Float          @default(2.3)
  intervalDays       Int            @default(0)
  lastReviewedAt     DateTime?
  nextReviewAt       DateTime?
  averageResponseMs  Int?
  lastErrorType      QuestionType?
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word               VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  updatedAt          DateTime       @updatedAt

  @@id([userId, wordId])
  @@index([masteryState])
  @@index([nextReviewAt])
}

model StudySession {
  id          String             @id @default(cuid())
  userId      String
  mode        StudySessionMode
  status      StudySessionStatus @default(active)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       StudySessionItem[]
  reviewLogs  ReviewLog[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model StudySessionItem {
  id           String         @id @default(cuid())
  sessionId    String
  wordId       String
  position     Int
  questionType QuestionType
  session      StudySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word         VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@unique([sessionId, position])
  @@index([wordId])
}

model ReviewLog {
  id             String         @id @default(cuid())
  idempotencyKey String         @unique
  sessionId      String
  userId         String
  wordId         String
  questionType   QuestionType
  rating         ReviewRating
  isCorrect      Boolean
  responseMs     Int
  answer         String?
  reviewedAt     DateTime
  session        StudySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  @@index([sessionId])
  @@index([userId, reviewedAt])
  @@index([wordId, reviewedAt])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  clientEventId String   @unique
  userId        String?
  name          String
  properties    Json
  occurredAt    DateTime
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([name, occurredAt])
}

model Checkin {
  id                String   @id @default(cuid())
  userId            String
  dateKey           String
  checkedInAt       DateTime @default(now())
  completedSessions Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
  @@index([checkedInAt])
}
