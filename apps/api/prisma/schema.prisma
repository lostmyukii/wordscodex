generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  learner
  admin
}

enum AccountType {
  guest
  registered
}

enum VocabularyCategory {
  k12
  college
  postgraduate
  overseas
  workplace
}

enum LearningGoal {
  k12
  college
  postgraduate
  overseas
  workplace
}

enum StudyPlanStatus {
  active
  paused
  completed
}

model SystemMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String        @id @default(cuid())
  email       String?       @unique
  displayName String        @default("学习者")
  role        UserRole      @default(learner)
  accountType AccountType   @default(guest)
  timezone    String        @default("Asia/Shanghai")
  sessions    AuthSession[]
  studyPlans  StudyPlan[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model VocabularyBook {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  category    VocabularyCategory
  description String
  wordCount   Int
  version     Int                @default(1)
  publishedAt DateTime?
  studyPlans  StudyPlan[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([category])
  @@index([publishedAt])
}

model StudyPlan {
  id                 String          @id @default(cuid())
  userId             String
  vocabularyBookId   String
  learningGoal       LearningGoal
  dailyNewWordTarget Int
  dailyReviewLimit   Int             @default(80)
  targetDate         DateTime?
  reminderEnabled    Boolean         @default(false)
  status             StudyPlanStatus @default(active)
  startedAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyBook     VocabularyBook  @relation(fields: [vocabularyBookId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([vocabularyBookId])
  @@index([status])
}
